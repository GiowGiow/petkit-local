{
  "config": {
    "flow_title": "{name}",
    "step": {
      "user": {
        "title": "Add a PetKit fountain",
        "description": "Pick a fountain that is currently advertising. Leave the secret blank to let Home Assistant claim the device with its own key.",
        "data": {
          "address": "Fountain",
          "secret": "Secret (optional)"
        },
        "data_description": {
          "secret": "Hex from the PetKit API (a CTW3 returns 12 characters). Only needed if you want to reuse the key PetKit assigned, so the official app keeps working."
        }
      },
      "confirm": {
        "title": "Add {name}",
        "description": "Set up {name} ({address}) for local Bluetooth control?\n\nLeaving the secret blank lets Home Assistant claim the fountain with its own key. The PetKit app will then need the fountain power-cycled before it can reconnect.",
        "data": {
          "secret": "Secret (optional)"
        },
        "data_description": {
          "secret": "Hex from the PetKit API (a CTW3 returns 12 characters). Only needed if you want to reuse the key PetKit assigned, so the official app keeps working."
        }
      }
    },
    "abort": {
      "already_configured": "This fountain is already set up.",
      "no_devices_found": "No PetKit fountains are advertising nearby. Bring the fountain closer to a Bluetooth adapter or proxy and try again.",
      "not_supported": "This PetKit device does not support local Bluetooth control."
    },
    "error": {
      "invalid_secret": "The secret must be hex, up to 8 bytes. The value from the PetKit API is usually 12 characters, for example 1a2b3c4d5e6f."
    }
  },
  "options": {
    "step": {
      "init": {
        "title": "Fountain options",
        "data": {
          "scan_interval": "Poll interval (seconds)",
          "keep_alive": "Keep the Bluetooth connection open"
        },
        "data_description": {
          "scan_interval": "How often to read state. With the connection held open the fountain also pushes changes as they happen, so this is a fallback rather than the main path.",
          "keep_alive": "Auto follows the fountain's own power source: it stays connected on mains, so commands are instant and pet visits are detected reliably, and disconnects between polls when running on battery."
        }
      }
    }
  },
