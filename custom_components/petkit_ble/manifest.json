{
  "domain": "petkit_ble",
  "name": "PetKit BLE (local)",
  "bluetooth": [
    {
      "local_name": "Petkit_CTW3*"
    },
    {
      "local_name": "Petkit_CTW2*"
    },
    {
      "local_name": "Petkit_W5*"
    },
    {
      "local_name": "Petkit_W4X*"
    }
  ],
  "codeowners": [
    "@b12e"
  ],
  "config_flow": true,
  "dependencies": [
    "bluetooth_adapters"
  ],
  "documentation": "https://github.com/b12e/petkit-local",
  "integration_type": "device",
  "iot_class": "local_polling",
  "issue_tracker": "https://github.com/b12e/petkit-local/issues",
  "loggers": [
    "petkit_ble"
  ],
  "requirements": [
    "bleak-retry-connector>=3.5.0"
  ],
  "version": "0.4.7"
}
